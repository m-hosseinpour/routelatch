[Unit]
Description=RouteLatch local proxy
# A user service needs the user manager and a usable network stack; it does
# not need (and must not wait for) a network-online target.
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# `run` is the foreground command (docs/contracts.md §7.1). The unit adds
# lifecycle only; it does not pass routing, DNS, proxy or environment settings.
ExecStart=%h/.local/bin/routelatch run

# Exit 4 means another instance owns the data dir, 6 a refused conflict and
# 10 corrupt state. Restarting cannot fix those, so systemd stops instead of
# looping.
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=4 6 10

# Let the process close listeners and flush state on SIGTERM; SIGKILL is only
# the last resort.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=20s

# Intentionally no User=/Group= (this is a user unit), no root, no TUN, no
# firewall/network namespace and no ProtectHome/PrivateNetwork hardening:
# RouteLatch needs the user's config/state directories and unmodified direct
# egress. Do not add Environment=HTTP_PROXY/... here; that would be a proxy
# setting outside the launcher's per-process contract.

[Install]
WantedBy=default.target
